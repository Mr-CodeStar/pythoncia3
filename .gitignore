# =============================================================================
# EduPulse Dashboard - Git Ignore Rules
# =============================================================================

# --- User-Specified Excluded Folders & Testing Files ---
# Raw Kaggle dataset folder (original un-enriched files)
Dataset/

# Internal automated test script (used for QA verification, not part of project submission)
test_dashboard.py

# --- Large Dataset Files (Exceeds GitHub 100MB limit) ---
# studentVle.csv is 1.32 GB and will be rejected by GitHub's 100MB hard limit.
# The app uses the compact pre-aggregated parquets in christ_dataset/.cache/ (~1.3 MB total)
christ_dataset/studentVle.csv

# Note: christ_dataset/.cache/ and *.parquet are TRACKED so Streamlit Community Cloud runs instantly!

# --- Python Environment & Bytecode ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Virtual Environments ---
venv/
.venv/
env/
.env/
ENV/
env.bak/
venv.bak/

# --- Streamlit Secrets & Local Config ---
.streamlit/secrets.toml

# --- IDEs & System Files ---
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
